{
  "manifest_version": 3,
  "name": "Article Formatter — Medium",
  "version": "0.2.0",
  "description": "Self-contained wizard: assemble an article (title, body, diagrams, AI/external images, captions, alt) and send it straight into an open Medium draft.",
  "permissions": ["clipboardRead", "clipboardWrite", "tabs"],
  "host_permissions": [
    "https://medium.com/*",
    "https://medium-formatter.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Article Formatter" },
  "content_scripts": [
    {
      "matches": ["https://medium.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
