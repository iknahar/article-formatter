{
  "manifest_version": 3,
  "name": "Article Formatter — Medium",
  "version": "0.3.0",
  "description": "Assemble an article (title, body, diagrams, AI/external images, captions, alt) inside an overlay right on your Medium draft, then insert.",
  "permissions": ["clipboardRead", "clipboardWrite", "tabs"],
  "host_permissions": [
    "https://medium.com/*",
    "https://medium-formatter.vercel.app/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Open Article Formatter" },
  "content_scripts": [
    {
      "matches": ["https://medium.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["wizard.html", "wizard.js", "wizard.css"],
      "matches": ["https://medium.com/*"]
    }
  ]
}
